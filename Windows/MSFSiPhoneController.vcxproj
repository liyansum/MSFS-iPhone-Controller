    <ClInclude Include="Json.h" />
    <ClInclude Include="FlightController.h" />
    <ClInclude Include="SimConnectManager.h" />
    <ClInclude Include="TelemetryManager.h" />
    <ClInclude Include="FlightPlanManager.h" />
    <ClInclude Include="UDPServer.h" />
