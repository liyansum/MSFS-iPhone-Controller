  <ItemGroup>
    <ResourceCompile Include="resource.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.ico" />
  </ItemGroup>
  <!-- 构建后把 SimConnect.dll 复制到 exe 旁（运行时依赖） -->
  <Target Name="CopySimConnectDll" AfterTargets="Build">
    <Copy SourceFiles="$(SimConnectSdkRoot)\lib\SimConnect.dll"
          DestinationFolder="$(OutDir)"
          Condition="Exists('$(SimConnectSdkRoot)\lib\SimConnect.dll')" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
